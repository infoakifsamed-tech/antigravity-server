PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

POSTGRES_URL=postgres://antigravity:antigravity@localhost:5432/antigravity
MONGO_URL=mongodb://localhost:27017/antigravity
REDIS_URL=redis://localhost:6379

# Adım 3'te JWT için kullanılacak (en az 32 karakter)
JWT_SECRET=degistir-bunu-en-az-32-karakterlik-gizli-anahtar

# Medya (S3 uyumlu: AWS S3 / Cloudflare R2). Bos birakirsaniz medya devre disi kalir.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<hesap>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
